# Base URL for the Laravel API. Leave unset in dev — Vite proxies /api to
# http://127.0.0.1:8000 (see vite.config.ts). In production point this at the
# deployed backend origin, e.g. https://api.sls.events/api
VITE_API_URL=

# Public origin of the site, used for canonical URLs, sitemap.xml and the
# absolute og:image that social scrapers require. Leave unset in dev — the
# app falls back to the origin it is served from, so a preview deployment
# never claims to be the canonical copy of production.
# Set this in the Vercel project (e.g. https://sls.gr) or shared links will
# unfurl without an image.
VITE_SITE_URL=
