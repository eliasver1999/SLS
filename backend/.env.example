APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Where the order and sign-in buttons in transactional emails point. A wrong
# value produces mail that looks correct and leads nowhere.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Minutes until an API token expires (default 14 days).
SANCTUM_EXPIRATION=20160

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email. MAIL_MAILER=log writes messages to storage/logs and delivers
# NOTHING — order confirmations, the sales notification and password resets
# all go silently into a file. It is the right setting for local work and an
# outage in production. `php artisan sls:preflight` will fail while it is set,
# and the admin panel shows a banner on every screen.
#
# To develop against email without credentials, run the local catcher and
# point this at it — the application takes the real SMTP path and every
# message is written to storage/app/mail as an .html you can open:
#
#     python tools/mail-catcher.py
#     MAIL_MAILER=smtp  MAIL_HOST=127.0.0.1  MAIL_PORT=1025
#
# The admin panel and sls:preflight both report a catcher as a WARNING, not
# as working email, so this configuration cannot be mistaken for production.
#
# For real delivery, set MAIL_MAILER=smtp with your provider's credentials,
# then publish SPF and DKIM records for the sending domain or the mail will
# be accepted and then filtered as spam. Verify with the Test button on any
# template in Admin → Emails, which reports where the message actually went.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Must be on a domain you control, or recipients' spam filters will drop it.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
